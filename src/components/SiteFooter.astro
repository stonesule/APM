---
import Wordmark from './Wordmark.astro';
import { estimateCta, footerNav } from '../config/navigation';
import { phoneHref, site } from '../config/site';
import { services } from '../config/services';

const { phone, email } = site.contact;
const hasContact = Boolean(phone || email);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__home" aria-label={`${site.legalName} home`}>
        <Wordmark tone="on-green" />
      </a>
      <p>
        {site.tagline}. Serving {site.market}.
      </p>
      <a href={estimateCta.href} class="site-footer__cta">
        {estimateCta.label} →
      </a>
    </div>

    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="site-footer__heading">
        Explore
      </h2>
      <ul class="site-footer__list">
        {footerNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__heading">Services</h2>
      <ul class="site-footer__list">
        {services.map((service) => (
          <li>{service.title}</li>
        ))}
      </ul>
    </div>

    {hasContact && (
      <div>
        <h2 class="site-footer__heading">Contact</h2>
        <ul class="site-footer__list">
          {phone && (
            <li>
              <a href={phoneHref(phone)}>{phone}</a>
            </li>
          )}
          {email && (
            <li>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          )}
        </ul>
      </div>
    )}
  </div>
  <div class="container site-footer__legal">
    <p>
      &copy; {year} {site.legalName}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  /* Every text color is set explicitly to cream on the green background. */
  .site-footer {
    background: var(--color-green-deep);
    color: var(--color-on-green);
    padding-block: var(--space-8) var(--space-5);
    font-size: var(--text-sm);
  }

  .site-footer :is(h2, p, li, a) {
    color: var(--color-on-green);
  }

  .site-footer :focus-visible {
    outline-color: var(--color-focus-on-green);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .site-footer__brand {
    max-width: 22rem;
  }

  .site-footer__home {
    display: inline-flex;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .site-footer__cta {
    font-weight: 600;
  }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__legal {
    margin-top: var(--space-7);
  }

  .site-footer__legal p {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 250 240 / 25%);
    font-size: var(--text-xs);
  }
</style>
