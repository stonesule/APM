---
export interface Props {
  /** Heading id, used to label the section for assistive technology. */
  labelledBy?: string;
  tone?: 'default' | 'alt' | 'light' | 'green';
  width?: 'default' | 'narrow';
  class?: string;
}

const { labelledBy, tone = 'default', width = 'default', class: className } = Astro.props;
---

<section class:list={['section', `section--${tone}`, className]} aria-labelledby={labelledBy}>
  <div class:list={['container', { 'container--narrow': width === 'narrow' }]}>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-space);
  }

  .section--alt {
    background: var(--color-surface-alt);
  }

  .section--light {
    background: var(--color-surface);
  }

  /* Green sections set every text color explicitly; nothing is inherited
     from the light-theme heading and paragraph styles. */
  .section--green {
    background: var(--color-green);
    color: var(--color-on-green);
  }

  .section--green :global(:is(h1, h2, h3, h4, p, li, .eyebrow, .lead)) {
    color: var(--color-on-green);
  }

  .section--green :global(a:not(.button)) {
    color: var(--color-on-green);
  }

  .section--green :global(:focus-visible) {
    outline-color: var(--color-focus-on-green);
  }
</style>
