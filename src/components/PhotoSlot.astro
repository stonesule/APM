---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * A photo area. Until an approved photo is supplied it renders a clearly
 * labelled placeholder describing the photo that belongs there. To use a
 * real photo, pass `image` and `alt` — normally from the projects collection
 * via getPhoto() in src/lib/photos.ts, so alt text lives in one place:
 *
 *   const photo = await getPhoto('powder-room-blue-green');
 *   <PhotoSlot image={photo.src} alt={photo.alt} label="Powder room" />
 */
export interface Props {
  /** What photo belongs here, e.g. "Finished interior". */
  label: string;
  /** Extra guidance shown on the placeholder. */
  note?: string;
  image?: ImageMetadata;
  alt?: string;
  ratio?: '3/4' | '4/5' | '1/1' | '4/3' | '3/2' | '16/9';
  /**
   * Crop focus (CSS object-position) when the slot ratio differs from the
   * photo's, e.g. '50% 40%'. Check crops at desktop, 390px, and 320px.
   */
  position?: string;
  /** Image sizes hint for responsive loading. */
  sizes?: string;
  /** eager + high fetch priority for the main above-the-fold photo only. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  label,
  note = 'Approved APM photo to be supplied.',
  image,
  alt,
  ratio = '4/3',
  position = '50% 50%',
  sizes = '(min-width: 64rem) 50vw, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

// Responsive widths, never larger than the source file.
const widths = image
  ? [
      ...new Set(
        [360, 540, 720, 960, 1280, 1600].filter((w) => w < image.width).concat(image.width),
      ),
    ]
  : [];

if (image && !alt) throw new Error(`PhotoSlot "${label}": alt text is required with an image.`);
---

<div class:list={['photo-slot', className]} style={`--ratio: ${ratio}; --position: ${position}`}>
  {image ? (
    <Image
      src={image}
      alt={alt ?? ''}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      class="photo-slot__img"
    />
  ) : (
    <div class="photo-slot__placeholder">
      <svg
        class="photo-slot__icon"
        viewBox="0 0 48 48"
        width="40"
        height="40"
        aria-hidden="true"
        focusable="false"
      >
        <rect
          x="5"
          y="9"
          width="38"
          height="30"
          rx="1"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path d="M5 33l11-11 9 9 6-6 12 12" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="33" cy="18" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <p class="photo-slot__tag">Photo placeholder</p>
      <p class="photo-slot__label">{label}</p>
      <p class="photo-slot__note">{note}</p>
    </div>
  )}
</div>

<style>
  .photo-slot {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .photo-slot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }

  .photo-slot__placeholder {
    position: absolute;
    inset: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
    border: 1px dashed var(--color-control-border);
    text-align: center;
    color: var(--color-text-secondary);
  }

  .photo-slot__icon {
    margin-bottom: var(--space-3);
  }

  .photo-slot__placeholder p {
    margin: 0;
    max-width: 22rem;
  }

  .photo-slot__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .photo-slot__label {
    margin-top: var(--space-2) !important;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .photo-slot__note {
    margin-top: var(--space-1) !important;
    font-size: var(--text-sm);
  }
</style>
