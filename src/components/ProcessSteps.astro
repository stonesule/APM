---
/** The proposed client process. Wording is provisional (see pending inputs). */
const steps = [
  {
    title: 'Share your ideas',
    text: 'Tell us about your space, what you would like to change, and how you use it.',
  },
  {
    title: 'Discuss the details',
    text: 'We talk through scope, priorities, and timing so the plan fits your project.',
  },
  {
    title: 'Bring it together',
    text: 'We coordinate the work and finish it with care, from preparation to the final details.',
  },
];
---

<ol class="process">
  {steps.map((step, index) => (
    <li class="process__step">
      <span class="process__number" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <h3 class="process__title">{step.title}</h3>
      <p class="process__text">{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .process {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__step {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-control-border);
  }

  .process__number {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-accent);
  }

  .process__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .process__text {
    margin: 0;
    color: var(--color-text-secondary);
  }
</style>
