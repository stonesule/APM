---
import Button from './Button.astro';
import { estimateCta } from '../config/navigation';

export interface Props {
  heading?: string;
  text?: string;
  buttonLabel?: string;
}

const {
  heading = 'Let’s create a space you love.',
  text = 'Tell us about your space and what you would like to accomplish, and we will talk through the next steps together.',
  buttonLabel = 'Tell us about your project',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-heading">
  <div class="container cta-band__inner">
    <div>
      <h2 id="cta-band-heading" class="cta-band__heading">
        {heading}
      </h2>
      <p class="cta-band__text">{text}</p>
    </div>
    <Button href={estimateCta.href} variant="on-green">
      {buttonLabel}
    </Button>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-8);
    background: var(--color-green);
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  /* Explicit cream on green — never rely on inherited heading colors. */
  .cta-band__heading {
    color: var(--color-on-green);
    margin-bottom: var(--space-3);
  }

  .cta-band__text {
    color: var(--color-on-green);
    max-width: 36em;
    margin: 0;
  }
</style>
