---
import Button from './Button.astro';
import Section from './Section.astro';
import { estimateCta } from '../config/navigation';

export interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Planning a project?',
  text = 'Tell us about your space and what you would like to accomplish. We will follow up to discuss next steps.',
} = Astro.props;
---

<Section tone="dark" labelledBy="estimate-cta-heading">
  <div class="cta">
    <div>
      <h2 id="estimate-cta-heading">{heading}</h2>
      <p>{text}</p>
    </div>
    <Button href={estimateCta.href} variant="secondary" class="cta__button">
      {estimateCta.label}
    </Button>
  </div>
</Section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .cta p {
    margin-bottom: 0;
    max-width: 38em;
  }

  .cta :global(.cta__button) {
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
    color: var(--color-primary);
  }

  .cta :global(.cta__button:hover) {
    background: var(--color-surface-alt);
  }

  .cta :global(.cta__button:focus-visible) {
    outline-color: var(--color-on-primary);
  }
</style>
