---
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { estimateCta } from '../config/navigation';
---

<BaseLayout title="Page not found" noindex>
  <Section labelledBy="not-found-heading" width="narrow">
    <p class="eyebrow">Error 404</p>
    <h1 id="not-found-heading">We couldn't find that page</h1>
    <p class="lead">The page may have moved, or the address may be mistyped.</p>
    <div class="actions not-found__actions">
      <Button href="/">Go to the homepage</Button>
      <Button href="/services/" variant="secondary">
        View our services
      </Button>
      <Button href={estimateCta.href} variant="secondary">
        {estimateCta.label}
      </Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .not-found__actions {
    margin-top: var(--space-6);
  }
</style>
