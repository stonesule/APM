---
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import EstimateCta from '../components/EstimateCta.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getService, servicesByTier } from '../config/services';
import { getPhoto } from '../lib/photos';

const painting = getService('painting');
const accentWalls = getService('accent-walls');
const supporting = servicesByTier('supporting');
const testimonials = await getCollection('testimonials', ({ data }) => !data.draft);

const values = [
  'Thoughtful design',
  'Quality workmanship',
  'Dependable service',
  'One trusted company',
];

const heroPhoto = await getPhoto('lounge-board-and-batten', 0);
const paintingPhoto = await getPhoto('apartment-black-walls');
const accentPhoto = await getPhoto('slat-accent-wall');

// Three complementary details: panelling, stair railing, and a finished room.
const detailPhotos = [
  {
    label: 'Board-and-batten panelling',
    ...(await getPhoto('lounge-board-and-batten', 1)),
    position: '60% 50%',
  },
  { label: 'Stairwell', ...(await getPhoto('stairwell-chandelier')), position: '50% 60%' },
  { label: 'Powder room', ...(await getPhoto('powder-room-blue-green')), position: '50% 50%' },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Interior Design &amp; Property Enhancement</p>
        <h1 id="hero-heading">Thoughtful spaces. Beautifully finished.</h1>
        <p class="lead">
          Professional painting, distinctive accent walls, and coordinated interior services—through
          one trusted company.
        </p>
        <div class="actions hero__actions">
          <Button href="/request-estimate/">Tell us about your project</Button>
          <Button href="/projects/" variant="secondary">
            Explore our work
          </Button>
        </div>
      </div>
      <PhotoSlot
        class="hero__photo"
        label="Finished interior"
        image={heroPhoto.src}
        alt={heroPhoto.alt}
        ratio="4/5"
        position="50% 45%"
        sizes="(min-width: 76rem) 34rem, (min-width: 56rem) 45vw, calc(100vw - 2.5rem)"
        loading="eager"
      />
    </div>
  </section>

  <section class="values" aria-label="What we stand for">
    <ul class="container values__list">
      {values.map((value) => (
        <li>{value}</li>
      ))}
    </ul>
  </section>

  <Section labelledBy="services-heading">
    <div class="section-heading">
      <p class="eyebrow">Our services</p>
      <h2 id="services-heading">Refresh. Refine. Reimagine.</h2>
      <p class="lead">
        Painting is at the heart of what we do. We also coordinate the related work that brings a
        space together, so you can rely on one company from start to finish.
      </p>
    </div>

    <div class="services">
      <article class="service service--core">
        <PhotoSlot
          label="Professional painting"
          image={paintingPhoto.src}
          alt={paintingPhoto.alt}
          ratio="4/3"
          position="50% 45%"
          sizes="(min-width: 56rem) 34rem, calc(100vw - 2.5rem)"
        />
        <div class="service__body">
          <p class="eyebrow">Our core specialty</p>
          <h3>
            <a href={painting.href ?? '/services/'}>{painting.title}</a>
          </h3>
          <p>{painting.summary}</p>
          <span class="service__more" aria-hidden="true">
            Learn more →
          </span>
        </div>
      </article>

      <article class="service">
        <PhotoSlot
          label="Custom accent wall"
          image={accentPhoto.src}
          alt={accentPhoto.alt}
          ratio="4/3"
          position="50% 40%"
          sizes="(min-width: 56rem) 34rem, calc(100vw - 2.5rem)"
        />
        <div class="service__body">
          <h3>
            <a href={accentWalls.href ?? '/services/'}>{accentWalls.title}</a>
          </h3>
          <p>{accentWalls.summary}</p>
          <span class="service__more" aria-hidden="true">
            Learn more →
          </span>
        </div>
      </article>

      <article class="service service--supporting">
        <div class="service__body">
          <h3>
            <a href="/services/#supporting">Property enhancement &amp; supporting services</a>
          </h3>
          <p>Related services we coordinate with your project:</p>
          <ul class="service__list">
            {supporting.map((service) => (
              <li>{service.title}</li>
            ))}
          </ul>
          <span class="service__more" aria-hidden="true">
            View all services →
          </span>
        </div>
      </article>
    </div>
  </Section>

  <Section tone="light" labelledBy="details-heading">
    <div class="section-heading">
      <p class="eyebrow">Our work</p>
      <h2 id="details-heading">A closer look at the details.</h2>
      <p class="lead">A few of the finishes and details from our past work.</p>
    </div>
    <div class="details">
      {detailPhotos.map((slot) => (
        <PhotoSlot
          label={slot.label}
          image={slot.src}
          alt={slot.alt}
          ratio="4/5"
          position={slot.position}
          sizes="(min-width: 76rem) 23rem, (min-width: 40rem) 31vw, calc(100vw - 2.5rem)"
        />
      ))}
    </div>
    <div class="actions details__actions">
      <Button href="/projects/" variant="secondary">
        Explore our work
      </Button>
    </div>
  </Section>

  <Section labelledBy="process-heading">
    <div class="section-heading">
      <p class="eyebrow">How we work</p>
      <h2 id="process-heading">A simple, considered process.</h2>
    </div>
    <ProcessSteps />
  </Section>

  {testimonials.length > 0 && (
    <Section tone="alt" labelledBy="testimonials-heading">
      <h2 id="testimonials-heading">What our clients say</h2>
      <div class="testimonials">
        {testimonials.map((entry) => (
          <figure class="testimonial">
            <blockquote set:html={entry.rendered?.html ?? ''} />
            <figcaption>{entry.data.attribution}</figcaption>
          </figure>
        ))}
      </div>
    </Section>
  )}

  <EstimateCta />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-7) var(--section-space);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .hero h1 {
    max-width: 11em;
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  .values {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .values__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-3) var(--space-5);
    margin-block: 0;
    padding-block: var(--space-5);
    list-style: none;
  }

  .values__list li {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-align: center;
  }

  .services {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }

    .service--core {
      grid-row: span 2;
    }
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
  }

  .service--core :global(.photo-slot) {
    flex: 1;
    aspect-ratio: auto;
    min-height: 18rem;
  }

  .service--supporting {
    background: var(--color-surface-alt);
  }

  .service__body {
    padding: var(--space-6) var(--space-5);
  }

  .service h3 a {
    color: inherit;
    text-decoration: none;
  }

  .service h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service h3 a:focus-visible {
    outline: none;
  }

  .service h3 a:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .service p {
    color: var(--color-text-secondary);
  }

  .service__list {
    margin-bottom: var(--space-5);
    padding-left: 1.1rem;
    color: var(--color-text);
  }

  .service__more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .service:hover .service__more {
    text-decoration: underline;
  }

  .details {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .details__actions {
    margin-top: var(--space-6);
  }

  .testimonials {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .testimonial {
    margin: 0;
    padding: var(--space-6);
    background: var(--color-surface);
  }

  .testimonial figcaption {
    font-weight: 600;
  }
</style>
