---
import PageHeader from '../components/PageHeader.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { phoneHref, site } from '../config/site';
import { services } from '../config/services';

// AMP-5 covers the visual layout only. The fields are disabled and there is
// no <form>, endpoint, storage, or success state. The working form
// (Formspree proposed) is a separate ticket and must report success only
// after confirmed delivery.
const { phone, email } = site.contact;
---

<BaseLayout
  title="Request an Estimate"
  description={`Request an estimate from ${site.legalName} for painting, accent walls, and property enhancement services.`}
>
  <PageHeader
    eyebrow="Request an estimate"
    title="Tell us about your project."
    lead="Share a few details about your space and what you have in mind, and we will discuss next steps with you."
  />

  <Section labelledBy="estimate-form-heading">
    <div class="estimate">
      <div class="estimate__panel">
        <h2 id="estimate-form-heading" class="estimate__heading">
          Project details
        </h2>

        <div class="notice" role="note" id="estimate-unavailable">
          <p class="notice__title">Online requests can’t be sent yet</p>
          <p>
            This form is a design preview. The fields are disabled, and nothing you see here sends
            or stores information.
          </p>
        </div>

        <fieldset class="fields" disabled aria-describedby="estimate-unavailable">
          <legend class="visually-hidden">Estimate request fields (disabled)</legend>

          <div class="field">
            <label for="estimate-name">Name</label>
            <input id="estimate-name" name="name" type="text" autocomplete="name" disabled />
          </div>

          <div class="field">
            <label for="estimate-email">Email</label>
            <input id="estimate-email" name="email" type="email" autocomplete="email" disabled />
          </div>

          <div class="field">
            <label for="estimate-phone">
              Phone <span class="field__optional">(optional)</span>
            </label>
            <input id="estimate-phone" name="phone" type="tel" autocomplete="tel" disabled />
          </div>

          <div class="field">
            <label for="estimate-location">Project city / ZIP</label>
            <input
              id="estimate-location"
              name="location"
              type="text"
              autocomplete="postal-code"
              disabled
            />
          </div>

          <div class="field field--full">
            <label for="estimate-service">Service</label>
            <select id="estimate-service" name="service" disabled>
              <option value="">Select a service</option>
              {services.map((service) => (
                <option value={service.slug}>{service.title}</option>
              ))}
              <option value="not-sure">Not sure yet</option>
            </select>
          </div>

          <div class="field field--full">
            <label for="estimate-description">Project description</label>
            <textarea id="estimate-description" name="description" rows="6" disabled></textarea>
            <p class="field__hint">
              The rooms or areas involved, what you would like to change, and your preferred timing.
            </p>
          </div>

          <div class="field field--full">
            <button type="button" class="submit" disabled>
              Send request (not yet available)
            </button>
          </div>
        </fieldset>
      </div>

      <aside class="estimate__aside" aria-labelledby="estimate-aside-heading">
        <h2 id="estimate-aside-heading" class="estimate__heading">
          Helpful details to share
        </h2>
        <ul>
          <li>The type of property and the rooms or areas involved</li>
          <li>The services you are interested in</li>
          <li>Your general location in the Atlanta area</li>
          <li>Your preferred timing</li>
          <li>Photos of the space, if you have them</li>
        </ul>
        <h2 class="estimate__heading" id="contact-details-heading">
          Contact details
        </h2>
        <dl class="details" aria-labelledby="contact-details-heading">
          <div class="details__row">
            <dt>Phone</dt>
            <dd>
              {phone ? (
                <a href={phoneHref(phone)}>{phone}</a>
              ) : (
                <span class="details__pending">Pending — not yet published</span>
              )}
            </dd>
          </div>
          <div class="details__row">
            <dt>Email</dt>
            <dd>
              {email ? (
                <a href={`mailto:${email}`}>{email}</a>
              ) : (
                <span class="details__pending">Pending — not yet published</span>
              )}
            </dd>
          </div>
        </dl>

        <h2 class="estimate__heading" id="coverage-heading">
          Service coverage
        </h2>
        <dl class="details" aria-labelledby="coverage-heading">
          <div class="details__row">
            <dt>Market</dt>
            <dd>{site.market.replace(/^the /, 'The ')}</dd>
          </div>
          <div class="details__row">
            <dt>Service area</dt>
            <dd>
              {site.serviceAreas.length > 0 ? (
                site.serviceAreas.join(', ')
              ) : (
                <span class="details__pending">
                  Pending — exact cities and boundaries to be confirmed
                </span>
              )}
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </Section>

  <Section tone="light" labelledBy="next-heading">
    <div class="section-heading">
      <p class="eyebrow">What happens next</p>
      <h2 id="next-heading">A simple, considered process.</h2>
    </div>
    <ProcessSteps />
  </Section>
</BaseLayout>

<style>
  .estimate {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .estimate {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .estimate__panel {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .estimate__heading {
    font-size: var(--text-xl);
  }

  .notice {
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-alt);
    border-left: 3px solid var(--color-accent);
  }

  .notice p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .notice .notice__title {
    margin-bottom: var(--space-1);
    font-weight: 600;
    color: var(--color-text);
  }

  .fields {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  @media (min-width: 40rem) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }

    .field--full {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .field__optional {
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: var(--space-3);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .field textarea {
    resize: vertical;
  }

  .field :disabled {
    cursor: not-allowed;
  }

  .field__hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .submit {
    justify-self: start;
    min-height: 3rem;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius);
    background: var(--color-surface-alt);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: not-allowed;
  }

  .estimate__aside ul {
    margin-bottom: var(--space-7);
    padding-left: 1.1rem;
    color: var(--color-text-secondary);
  }

  .details {
    margin: 0 0 var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .details__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .details dt {
    font-weight: 600;
    color: var(--color-text);
  }

  .details dd {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .details__pending {
    font-style: italic;
  }

  .estimate__aside li + li {
    margin-top: var(--space-2);
  }
</style>
