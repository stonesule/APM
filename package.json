{
  "name": "apm-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website for APM Interior Design, LLC — Interior Design & Property Enhancement.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "build:preview": "PUBLIC_ALLOW_INDEXING=false astro build",
    "preview": "astro preview",
    "preview:worker": "npm run build:preview && wrangler dev --port 8787",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run check && npm run build",
    "cf:whoami": "wrangler whoami",
    "deploy:check": "npm run build:preview && wrangler deploy --dry-run",
    "deploy:preview": "npm run validate && node scripts/check-deploy-ready.mjs && npm run build:preview && wrangler deploy --tag \"$(git rev-parse --short HEAD)\" --message \"Preview of $(git rev-parse --short HEAD)\"",
    "verify:hosting": "node scripts/verify-hosting.mjs"
  },
  "dependencies": {
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
