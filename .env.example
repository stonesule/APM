# Copy to .env for local development. Never commit real values in .env.
#
# Every variable prefixed PUBLIC_ is embedded in the generated HTML/JS and is
# visible to anyone who views the site. Only put values here that are safe to
# publish. This static site has no server-side secrets.

# Absolute production URL, e.g. https://www.example.com (domain pending).
# Used for canonical URLs and Open Graph tags. Leave empty until confirmed.
PUBLIC_SITE_URL=

# Set to "true" only for the approved production deployment. Any other value
# adds <meta name="robots" content="noindex"> so previews are not indexed.
PUBLIC_ALLOW_INDEXING=

# Formspree form ID (public; it appears in the form's action URL).
# Reserved for the estimate-form ticket — the scaffold does not render a form.
PUBLIC_FORMSPREE_FORM_ID=
